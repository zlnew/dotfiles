[Unit]
Description=Hermes Agent Web Dashboard (tailnet-exposed, password-gated)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Bind to the machine's Tailscale hostname (not 127.0.0.1) so the dashboard's
# Host-header guard accepts the Host: nova.tail...ts.net that Tailscale Serve
# forwards. A non-loopback bind engages the auth gate, so basic-auth (supplied
# via the env file below) is ENFORCED — unlike a loopback bind.
# Port 9180 (9119 is held by an orphaned prior process).
ExecStartPre=/bin/bash -lc 'for i in $(seq 1 30); do getent hosts nova.tail001da5.ts.net >/dev/null 2>&1 && exit 0; sleep 1; done; echo "tailscale hostname did not resolve"; exit 1'
ExecStart=/home/zlnew/.hermes/hermes-agent/venv/bin/hermes dashboard --host nova.tail001da5.ts.net --port 9180 --no-open
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=15

# Secrets & runtime — credentials come from the env file (600), never config.yaml
EnvironmentFile=/home/zlnew/.config/hermes-dashboard.env
Environment=HERMES_HOME=/home/zlnew

# Hardening (best-effort for a user service)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/home/zlnew/.hermes /home/zlnew/.cache /home/zlnew/.config
PrivateTmp=yes

[Install]
WantedBy=default.target
