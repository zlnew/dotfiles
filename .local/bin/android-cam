#!/usr/bin/env bash
sudo modprobe -r v4l2loopback

sudo modprobe v4l2loopback \
  devices=2 \
  video_nr=10,11 \
  card_label="PhoneCam","OBSVirtualCam" \
  exclusive_caps=1,1

scrcpy \
  --video-source=camera \
  --camera-size=1920x1080 \
  --camera-facing=front \
  --v4l2-sink=/dev/video10 \
  --max-fps=30 \
  --no-audio \
  --no-playback \
  --no-window
