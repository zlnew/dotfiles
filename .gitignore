# Machine secrets (real values live in ~/.env, copied from .env.example)
.env

# Build output
pkg/colorgen/colorgen

# Generated debug dump (rewritten on every colorgen run)
pkg/colorgen/resolved.json

# Editor / tool backup cruft
*.bak
*.tmp
*~
*.swp
*.swo

# Fish machine-local state (universal vars, fisher cache)
.config/fish/fish_variables
.config/fish/themes/*

# Local backup dir created by install.sh
.dotfiles_backup/
